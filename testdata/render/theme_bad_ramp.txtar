A theme file whose gradient ramp is invalid is rejected and the built-in theme is used
-- input.json --
{"rate_limits":{"five_hour":{"used_percentage":60,"resets_at":1760009000}},"session_id":"abc123"}
-- config --
theme = ~/bad.yaml
segments = rate5h
-- tree --
bad.yaml=colors:\n  text: ""\n  muted: dim\n  good: green\n  warn: yellow\n  bad: red\n  marker: bold\n  path: bold 33\nbar:\n  style: gradient\n  full: "▰"\n  partials: ["▏", "▎", "▍", "▌", "▋", "▊", "▉"]\n  empty: "▱"\n  marker: "/"\n  ramp: ["#fff", "#000000", "#000000"]
-- output --
5h: \e[32m██████████\e[0m\e[1m┃\e[0m\e[32m█\e[0m\e[2m░░░░░░░░\e[0m 60%
