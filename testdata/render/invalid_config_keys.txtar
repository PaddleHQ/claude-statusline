Malformed config keys are ignored while the valid ones around them still apply
-- input.json --
{"model":{"display_name":"Opus 4.7"},"effort":{"level":"high"},"session_id":"abc123"}
-- config --
model.effort.x = false
Model.effort = false
model-effort = false
model..effort = false
.effort = false
model. = false
segments.x = nothing
separator = ok
segments = model model
-- output --
Opus 4.7 [high] \e[2mok\e[0m Opus 4.7 [high]
