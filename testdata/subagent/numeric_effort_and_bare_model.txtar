"t1"	\e[1mx\e[0m \e[2m·\e[0m custom-model-1\e[2m [31999]\e[0m \e[2m·\e[0m ctx: \e[32m███▎\e[0m\e[2m░░░░░░\e[0m \e[32m33%\e[0m \e[2m·\e[0m 33.3k \e[2m·\e[0m \e[2mnumeric effort\e[0m
