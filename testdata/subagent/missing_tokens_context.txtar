"t1"	\e[1ma\e[0m \e[2m·\e[0m opus-4-7\e[2m [high]\e[0m \e[2m·\e[0m \e[2mNo token count\e[0m
"t2"	\e[1mb\e[0m \e[2m·\e[0m opus-4-7 \e[2m·\e[0m 4.2k
"t3"	\e[1mc\e[0m \e[2m·\e[0m opus-4-7 \e[2m·\e[0m 4.2k \e[2m·\e[0m \e[2mZero window\e[0m
